{
  "name": "agentlens",
  "displayName": "AgentLens",
  "description": "Universal AI Agent File Monitor for VS Code",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentlens",
          "title": "AgentLens",
          "icon": "media/agentlens.svg"
        }
      ]
    },
    "views": {
      "agentlens": [
        {
          "id": "agentlens.sessions",
          "name": "Sessions"
        },
        {
          "id": "agentlens.activity",
          "name": "Recent Activity"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentlens.filterActivity",
          "when": "view == agentlens.activity",
          "group": "navigation"
        },
        {
          "command": "agentlens.clearActivityFilter",
          "when": "view == agentlens.activity && agentlens.filterActive",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentlens.sessions",
        "contents": "No agent sessions yet."
      },
      {
        "view": "agentlens.activity",
        "contents": "No agent activity yet. Pre-edit events and file changes made in the workspace appear here.",
        "when": "!agentlens.filterActive"
      },
      {
        "view": "agentlens.activity",
        "contents": "No activity matches the current filter.",
        "when": "agentlens.filterActive"
      }
    ],
    "commands": [
      {
        "command": "agentlens.enable",
        "title": "Enable",
        "category": "AgentLens"
      },
      {
        "command": "agentlens.disable",
        "title": "Disable",
        "category": "AgentLens"
      },
      {
        "command": "agentlens.pause",
        "title": "Pause Auto Focus",
        "category": "AgentLens"
      },
      {
        "command": "agentlens.resume",
        "title": "Resume Auto Focus",
        "category": "AgentLens"
      },
      {
        "command": "agentlens.clearHistory",
        "title": "Clear Activity History",
        "category": "AgentLens"
      },
      {
        "command": "agentlens.filterActivity",
        "title": "Filter Activity...",
        "category": "AgentLens",
        "icon": "$(filter)"
      },
      {
        "command": "agentlens.clearActivityFilter",
        "title": "Clear Activity Filter",
        "category": "AgentLens",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentlens.sendMockEvent",
        "title": "Send Mock Pre-edit Event for Active File",
        "category": "AgentLens"
      }
    ],
    "configuration": {
      "title": "AgentLens",
      "properties": {
        "agentlens.autoFocus": {
          "type": "boolean",
          "default": true,
          "description": "Open the file an agent is about to edit when a reliable pre-edit event is received."
        },
        "agentlens.focusCooldownMs": {
          "type": "integer",
          "default": 1000,
          "minimum": 0,
          "description": "Minimum time between automatic file opens. Requests during the cooldown are collapsed and only the latest file is opened afterwards. 0 disables the cooldown."
        },
        "agentlens.ignoredFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [".git", "node_modules"],
          "description": "Folder names whose files are ignored by the filesystem fallback, at any depth."
        },
        "agentlens.maxTabs": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "description": "Target number of open tabs. Tabs that are pinned, dirty or active are never closed, so this limit may be exceeded."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:test": "node esbuild.mjs --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "npm run build:test && node scripts/run-integration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
